{
  "buildCommand": "cd api && npm install && cd ../client && npm install && npm run build",
  "outputDirectory": "dist",
  "installCommand": "echo 'deps installed in buildCommand'",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
